# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Configuration (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/nexaplay?schema=public"

# Authentication & Sessions
JWT_SECRET="super-secret-jwt-key-change-in-production"
NEXTAUTH_SECRET="super-secret-auth-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Redis Caching (Distributed caching layer)
REDIS_URL="redis://localhost:6379"

# Object Storage (Cloudflare R2, AWS S3, or Supabase Storage)
STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
STORAGE_BUCKET="nexaplay-videos"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Federated Video Networks
PEERTUBE_DEFAULT_INSTANCE="https://peertube.tv"

